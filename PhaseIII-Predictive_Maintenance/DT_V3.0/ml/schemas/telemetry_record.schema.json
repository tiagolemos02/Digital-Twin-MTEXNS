{
  "$defs": {
    "DataSource": {
      "description": "Permitted provenance labels, kept distinct by experimental purpose.",
      "enum": [
        "synthetic_historical",
        "mqtt_prospective",
        "real_shadow"
      ],
      "title": "DataSource",
      "type": "string"
    },
    "DatasetSplit": {
      "enum": [
        "train",
        "validation",
        "test",
        "prospective",
        "shadow"
      ],
      "title": "DatasetSplit",
      "type": "string"
    }
  },
  "$id": "https://mtex.local/schemas/v1.1/telemetry_record.schema.json",
  "additionalProperties": false,
  "description": "Canonical, privacy-safe row used after source ingestion.",
  "properties": {
    "ambient_humidity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ambient Humidity"
    },
    "ambient_temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ambient Temperature"
    },
    "copies_printed": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Copies Printed"
    },
    "copies_requested": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Copies Requested"
    },
    "data_source": {
      "$ref": "#/$defs/DataSource"
    },
    "iamalive": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Iamalive"
    },
    "ink_area_humidity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ink Area Humidity"
    },
    "ink_area_temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ink Area Temperature"
    },
    "machine_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Machine Id",
      "type": "string"
    },
    "machine_status": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Machine Status"
    },
    "print_bar_time_since_last_pm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Print Bar Time Since Last Pm"
    },
    "print_bar_time_since_last_pm_maximum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Print Bar Time Since Last Pm Maximum"
    },
    "print_bar_traveled_distance_since_last_pm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Print Bar Traveled Distance Since Last Pm"
    },
    "print_bar_traveled_distance_since_last_pm_maximum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Print Bar Traveled Distance Since Last Pm Maximum"
    },
    "pump_supply_color_1_work_time_since_replacement": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pump Supply Color 1 Work Time Since Replacement"
    },
    "pump_supply_color_1_work_time_since_replacement_maximum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pump Supply Color 1 Work Time Since Replacement Maximum"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "speed_mms_print_bar": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speed Mms Print Bar"
    },
    "speed_mms_transport": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speed Mms Transport"
    },
    "speed_rpm_print_bar": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speed Rpm Print Bar"
    },
    "speed_rpm_transport": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speed Rpm Transport"
    },
    "split": {
      "$ref": "#/$defs/DatasetSplit"
    },
    "time_index": {
      "format": "date-time",
      "title": "Time Index",
      "type": "string"
    },
    "transport_vacuum_work_time_since_last_air_filter_pm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transport Vacuum Work Time Since Last Air Filter Pm"
    },
    "transport_vacuum_work_time_since_last_air_filter_pm_maximum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transport Vacuum Work Time Since Last Air Filter Pm Maximum"
    }
  },
  "required": [
    "machine_id",
    "time_index",
    "data_source",
    "split"
  ],
  "title": "TelemetryRecord",
  "type": "object"
}
